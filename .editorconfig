# Editor settings. Windows PowerShell 5.1 misreads non-ASCII text in a .ps1 saved without a BOM,
# so scripts are UTF-8 WITH BOM; tools\sync.ps1 -Check enforces it in CI.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.ps1]
charset = utf-8-bom
indent_size = 4

[*.cmd]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
